# =====================================================================
# EVENT BOOKING SYSTEM - GLOBAL ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and adjust values for your local development.
# NEVER commit .env to version control or expose real production secrets.
# =====================================================================

# ---------------------------------------------------------------------
# General Application Settings
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
JWT_ISSUER=event-booking-auth
JWT_AUDIENCE=event-booking-services

# ---------------------------------------------------------------------
# Infrastructure: MySQL & RabbitMQ
# ---------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword_dev_only
MYSQL_DEV_USER=app_user
MYSQL_DEV_PASSWORD=app_password_dev_only

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# ---------------------------------------------------------------------
# API Gateway (Port 8000)
# ---------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://localhost:8001
EVENT_SERVICE_URL=http://localhost:8002
BOOKING_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Service 1: Auth Service (Port 8001)
# Database: event_auth_db
# ---------------------------------------------------------------------
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_DATABASE_URL=mysql+pymysql://app_user:app_password_dev_only@localhost:3306/event_auth_db
# Generate development secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_jwt_secret_change_in_production_min_32_chars_long_12345
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRE_MINUTES=15

# ---------------------------------------------------------------------
# Service 2: Event Service (Port 8002)
# Database: event_catalog_db
# ---------------------------------------------------------------------
EVENT_HOST=0.0.0.0
EVENT_PORT=8002
EVENT_DATABASE_URL=mysql+pymysql://app_user:app_password_dev_only@localhost:3306/event_catalog_db

# ---------------------------------------------------------------------
# Service 3: Booking Service (Port 8003)
# Database: event_booking_db
# ---------------------------------------------------------------------
BOOKING_HOST=0.0.0.0
BOOKING_PORT=8003
BOOKING_DATABASE_URL=mysql+pymysql://app_user:app_password_dev_only@localhost:3306/event_booking_db
# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_KEY
RAZORPAY_ENABLED=true

# ---------------------------------------------------------------------
# Service 4: Notification Service (Port 8004)
# Database: event_notification_db
# ---------------------------------------------------------------------
NOTIFICATION_HOST=0.0.0.0
NOTIFICATION_PORT=8004
NOTIFICATION_DATABASE_URL=mysql+pymysql://app_user:app_password_dev_only@localhost:3306/event_notification_db
# Local development SMTP (e.g., Mailpit or console fake backend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev_smtp_user
SMTP_PASSWORD=dev_smtp_password
SMTP_FROM_EMAIL=no-reply@eventbooking.local
SMTP_USE_TLS=false
