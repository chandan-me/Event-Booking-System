# =====================================================================
# EVENT BOOKING SYSTEM - GITIGNORE
# =====================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
scratch/
*.tmp
*.bak
*.exe
infra/mailpit/

# Virtual Environments
.venv/
venv/
ENV/
env/
*.venv/

# Environment Variables & Secrets (Prevent any .env from entering repo)
.env
.env.*
*.env
**/.env
**/.env.*
*.pem
*.key
*.cert
*.crt

# Documentation & Specifications (Do not add docs to git repo)
docs/
*.doc
*.docx
*.pdf
*.postman_collection.json

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage/
*.lcov

# Database & Runtime Data
*.sqlite3
*.db
data/
mysql_data/
rabbitmq_data/

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
